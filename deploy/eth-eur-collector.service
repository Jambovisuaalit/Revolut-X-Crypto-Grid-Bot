[Unit]
Description=Revolut X ETH/EUR public market data collector - READ ONLY
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=revxcollector
Group=revxcollector
WorkingDirectory=/opt/revx-bot
Environment=PYTHONPATH=/opt/revx-bot
Environment=LIVE_TRADING=false
Environment=DRY_RUN=true
ExecStart=/opt/revx-bot/.venv/bin/python /opt/revx-bot/scripts/eth_eur_persistent_collector.py run --db /var/lib/revx-eth-eur/collector.sqlite
StateDirectory=revx-eth-eur
Restart=on-failure
# SQLite lease requires 60s expiry after crash; suppress overlapping writers.
RestartSec=65s
TimeoutStopSec=25s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/revx-eth-eur
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
