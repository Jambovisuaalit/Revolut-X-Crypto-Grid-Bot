REVX_API_KEY=replace_me
REVX_PRIVATE_KEY_PATH=/run/secrets/revx_private_key.pem
REVX_SYMBOL=BTC-USD
REVX_REGION=EEA
QUOTE_CURRENCY=USD

DRY_RUN=true
LIVE_TRADING_ENABLED=false
GRID_LEVELS_PER_SIDE=3
GRID_SPACING_BPS=25
ORDER_ALLOCATION_PCT=1.0
RECENTER_THRESHOLD_BPS=75
LOOP_INTERVAL_SECONDS=5
MAX_MARKET_AGE_MS=5000
BOT_STATE_DB=bot_state.db
LOG_LEVEL=INFO
